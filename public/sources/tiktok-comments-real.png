.day_plan_input i { font-size: 1.5rem; position: absolute; opacity: 1; z-index: 9; right: 1.5rem; top: 25%; } .custom_select { color: #2d74b1 !important; background: #fff none !important; background-clip: padding-box !important; border: 1px solid #ced4da !important; } .price-tag { color: #176325 !important; background-color: white; filter: brightness(97%) contrast(90%) grayscale(10%); z-index: -1; } .price-tag .price-text { opacity: .8 !important; font-size: 1.25rem; color: black; } .sampleUrlIconTitle { float: right; margin-right: 0.5rem; cursor: pointer; color: #2d74b1; } #tooltipContainer { color: #0c5460; background-color: #d1ecf1; border-color: #bee5eb; padding: 1rem; margin-top: 1rem; } .comment-ai-generate .loader-container { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 20px; border: 1px solid #a0c0e0; background-color: #e6f0fa; border-radius: 10px; } .loader { border: 16px solid #f3f3f3; border-top: 16px solid #3498db; border-radius: 50%; width: 60px; height: 60px; animation: spin 2s linear infinite; margin-bottom: 20px; } .tooltip-container-title { display: flex; justify-content: space-between; align-items: center; font-weight: bold; } @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } } .loading-text { font-family: Arial, sans-serif; font-size: 18px; color: #2c3e50; } .sample-url-item { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; position: relative; } .sample-url-item:hover::after { content: attr(data-full-text); position: absolute; background: #333; color: #fff; padding: 5px; border-radius: 3px; white-space: nowrap; z-index: 1; top: 100%; left: 0; } #postTimeControl{ background: #D1ECF1; border: 1px solid #AADEE5 } #postTimeControlNormal{ color: #0A5460; text-align: left; } .close-button{ color: #0A5460; font-size: 32px; font-weight: 100; } .delivery-time-icon{ display: flex; align-items: center; color: #0A5460 !important; } .post-time-control{ cursor: default !important; } @media only screen and (max-width: 768px) { .card-row { display: flex; justify-content: space-between; align-items: stretch; } .card-row .col-6 { flex: 1; height: auto; max-width: 50%; padding: 5px; box-sizing: border-box; display: flex; align-items: stretch; } .card-discount{ height:auto; } } @media only screen and (max-width: 480px) { .card-row .col-6 { flex: 1; height: auto; max-width: 50%; padding: 5px; box-sizing: border-box; display: flex; align-items: stretch; } } .spinner { display: inline-block; width: 16px; height: 16px; border: 2px solid rgba(0, 0, 0, 0.1); border-top: 2px solid #000; border-radius: 50%; animation: spin 0.6s linear infinite; margin-left: 10px; } @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } } </style> <style> .discount-banner { font-family: Arial, sans-serif; width: 100%; border: 2px solid #D2E3EC; border-radius: 8px; padding: 10px 16px; display: flex; align-items: center; justify-content: space-between; background: linear-gradient(135deg, rgba(0, 255, 0, 0) 50%, rgba(0, 255, 0, 0.2) 100%); position: relative; overflow: hidden; } .discount-banner::before { content: ""; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-image: linear-gradient(135deg, rgba(255, 255, 255, 1) 0%,rgba(255, 255, 255, 1) 60%, rgba(0, 255, 0, 0) 100%), /* Sağdan sola transparanlık */ linear-gradient(rgba(0, 255, 0, .3) 1px, transparent 1px), /* Yatay grid çizgileri */ linear-gradient(90deg, rgba(0, 255, 0, .3) 1px, transparent 1px); /* Dikey grid çizgileri */ background-size: 100% 100%, 20px 20px, 20px 20px; z-index: 0; } .text-content { z-index: 1; } .text-content .discount-banner-title { font-size: 12px; color: #333; margin-bottom: 4px; } .text-content .amount { font-size: 18px; font-weight: bold; color: #333; } .text-content .price { font-size: 18px; font-weight: bold; color: #28a745; margin-left: 6px; } .cheaper-label { position: absolute; top: 50%; transform: translateY(-50%); right: 50px; color: #009AE1; padding: 2px 6px; border-radius: 4px; z-index: 2; font-size: 14px; font-style: normal; font-weight: 700; line-height: 16px; } .cheaper-label-text, .cheaper-label-percent { width: fit-content; background: #fff; padding: 3px; border-radius: 4px; } .discount-button { display: inline-block; background: #00D05C; color: #fff; padding: 6px 14px; border-radius: 79.55px; text-decoration: none; font-size: 14px; font-weight: bold; cursor: pointer; z-index: 1; outline: 0; border: 0; } .discount-button:focus { outline: 0; } .discount-button:hover { background: #10c561; color: #fff; } .icon-container { position: absolute; right: 16px; top: 16px; z-index: 1; } .icon-container img { width: 65px; height: auto; } </style> <style> .price-card { font-family: Arial, sans-serif; width: 100%; height: 100%; border: 2px solid #D2E3EC; border-radius: 8px; display: flex; align-items: center; justify-content: space-evenly; padding: 16px; background-color: #F9F9F9; position: relative; } .price-card::before { content: ""; position: absolute; top: 0; left: 0; width: 100%; height: 100%; border-radius: 8px; background-image: linear-gradient(135deg, rgba(249,249,249, 1) 0%,rgba(249,249,249, 1) 60%, rgba(0, 255, 0, 0) 100%), /* Sağdan sola transparanlık */ linear-gradient(rgba(0, 255, 0, .3) 1px, transparent 1px), /* Yatay grid çizgileri */ linear-gradient(90deg, rgba(0, 255, 0, .3) 1px, transparent 1px); /* Dikey grid çizgileri */ background-size: 100% 100%, 20px 20px, 20px 20px; z-index: 0; } .price-item { display: flex; align-items: center; position: relative; z-index: 1; } .price-item svg { width: 24px; height: 24px; margin-right: 8px; } .price-item > .price-item-text { font-size: 16px; font-weight: bold; color: #333; margin-bottom: 0; } .divider { width: 1px; height: 40px; background-color: #000; opacity: 0.1; z-index: 1; } .old-price { color: #9a9a9a; text-align: center; z-index: 1; } .old-price > .old-price-text { font-size: 10px; color: #9CA8B6; font-weight: 600; margin-bottom: 0; } .old-price .amount { font-size: 18px; font-weight: bold; margin-bottom: 0; } .discounted-price { color: #00D05C; text-align: center; z-index: 1; } .discounted-price > .discounted-price-text { color: #00D05C; font-size: 10px; font-weight: 600; margin-bottom: 0; } .discounted-price .amount { font-size: 24px; font-weight: 700; margin-bottom: 0; } </style> <div class="product-page"> <div class="items-tabs"> <div class="space-between menu-selected-container"> <div class="page-buttons menu-buttons parent-menu"></div> <div class="howToTooltipBtn"> <button type="button" class="btn invisible" data-url="" id="howToTooltip_1" data-toggle="tooltip" data-placement="left" onclick="isJqLoaded('howToPay',['frontend'],[this])" title="Buy Instagram Followers, Likes &amp; More Video Guide" aria-label="Buy Instagram Followers, Likes &amp; More Video Guide"></button> </div> </div> </div></div> <section> </section> <div id="tocPlugin"></div> <article class="product-article" id="contentAll"> <div class="warningTopPages"> <div class="row"> <div class="col-12"> <div class="alert alert-success alert-dismissible fade mb-3 show" role="alert"> <span class="icon-success"></span> Famety has been delivering trusted Instagram and TikTok followers, likes, and views since 2013, with instant delivery and top rated service. <button type="button" class="close" data-dismiss="alert"> <span>×</span> </button> </div> </div> </div> </div> <div class="entry-content"><style type="text/css">@font-face{ font-family:"fmt-icon"; font-style:normal; font-weight:400; font-display:swap; src:url("https://www.famety.net/system/fonts/system-icon.woff?5gojgc") format("woff"), url("https://www.famety.net/system/fonts/system-icon.ttf?5gojgc") format("truetype");}.fmt-scope i[class*="fmt-i-"]{ font-family:"fmt-icon" !important; font-style:normal;font-weight:400;font-variant:normal;text-transform:none; line-height:1;speak:none;display:inline-block; -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;}.fmt-scope .fmt-i-instagram::before{content:"e922";}.fmt-scope .fmt-i-tiktok::before{content:"e982";}.fmt-scope .fmt-i-youtube::before{content:"e921";}.fmt-scope .fmt-i-facebook::before{content:"e91e";}.fmt-scope .fmt-i-twitter::before{content:"e980";}.fmt-scope .fmt-i-search::before{content:"f002";}.fmt-scope .fmt-i-follower::before{content:"e916";}.fmt-scope .fmt-i-star::before{content:"e925";}.fmt-scope{ --fmt-brand:#311D7C; --fmt-accent:#F261A7; --fmt-accent2:#A077DD; --fmt-ig:#E1306C; --fmt-ig2:#F56040; --fmt-tt:#FE2C55; --fmt-tt2:#25F4EE; --fmt-yt:#FF0000; --fmt-ink:#1f2937; --fmt-muted:#6b7280; --fmt-card:#fff; --fmt-ring:rgba(49,29,124,.18); --fmt-trust:#00b67a; --fmt-soft:radial-gradient(60% 80% at 100% 0%, rgba(49,29,124,.10), transparent 60%), radial-gradient(70% 70% at 0% 100%, rgba(242,97,167,.10), transparent 60%); font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Open Sans",sans-serif; color:var(--fmt-ink); box-sizing:border-box;}.fmt-scope *,.fmt-scope *::before,.fmt-scope *::after{box-sizing:border-box;}.fmt-sec{max-width:1140px;margin:56px auto;padding:40px 22px;text-align:center; background:var(--fmt-soft);border-radius:22px;position:relative;overflow:hidden;isolation:isolate; box-shadow:0 1px 0 rgba(49,29,124,.05),0 12px 36px rgba(160,119,221,.18);}.fmt-sec--plain{background:none;box-shadow:none;}.fmt-sec h2{font-size:clamp(26px,3.2vw,38px);letter-spacing:-.02em;color:var(--fmt-brand);margin:0 0 10px;font-weight:800;}.fmt-sec-sub{font-size:clamp(14px,1.6vw,18px);margin:0 auto 34px;color:var(--fmt-muted);max-width:760px;line-height:1.6;}.fmt-btn{display:inline-flex;align-items:center;justify-content:center;padding:14px 30px;border-radius:999px; text-decoration:none;font-weight:800;letter-spacing:.2px;font-size:15px; transition:transform 160ms ease,box-shadow 200ms ease;}.fmt-btn-primary{background:linear-gradient(135deg,var(--fmt-brand),var(--fmt-accent));color:#fff;box-shadow:0 12px 30px rgba(49,29,124,.28);}.fmt-btn-primary:hover{transform:translateY(-2px);box-shadow:0 16px 38px rgba(242,97,167,.35);color:#fff;}.fmt-btn-ghost{background:#fff;color:var(--fmt-brand);border:2px solid rgba(49,29,124,.25);}.fmt-btn-ghost:hover{border-color:var(--fmt-brand);color:var(--fmt-brand);transform:translateY(-2px);}.fmt-btn:focus-visible{outline:none;box-shadow:0 0 0 4px #fff,0 0 0 8px var(--fmt-ring);}.fmt-hero{max-width:1180px;margin:24px auto 40px;padding:38px 22px;background:var(--fmt-soft); border-radius:24px;box-shadow:0 1px 0 rgba(49,29,124,.05),0 12px 36px rgba(160,119,221,.16); display:grid;grid-template-columns:1fr 1fr;gap:34px;align-items:center;}@media (max-width:980px){.fmt-hero{grid-template-columns:1fr;gap:26px;padding:30px 18px;}}.fmt-hero-left{text-align:left;min-width:0;}.fmt-hero h1{font-size:clamp(26px,3.6vw,40px);line-height:1.15;letter-spacing:-.02em;font-weight:800;color:var(--fmt-brand);margin:0 0 10px;}.fmt-hero-value{font-size:clamp(16px,1.9vw,20px);line-height:1.5;color:var(--fmt-ink);font-weight:600;margin:0 0 16px;max-width:52ch;}.fmt-rating{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:0 0 18px;}.fmt-rating-stars{color:var(--fmt-trust);font-size:18px;letter-spacing:2px;line-height:1;}.fmt-rating-copy{font-size:14px;font-weight:600;color:#374151;}.fmt-rating-copy a{color:#374151;text-decoration:underline;}.fmt-cta-row{display:flex;gap:12px;flex-wrap:wrap;margin:0 0 18px;}.fmt-pay{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:0 0 12px;}.fmt-pay-badge{font-size:11.5px;font-weight:700;color:var(--fmt-muted);background:#fff; border:1px solid rgba(49,29,124,.14);border-radius:8px;padding:5px 10px;line-height:1;white-space:nowrap;}.fmt-microline{font-size:13px;color:var(--fmt-brand);font-weight:700;margin:0;}.fmt-microline em{font-style:normal;color:rgba(49,29,124,.35);margin:0 6px;}.fmt-hero-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;min-width:0;}@media (max-width:640px){.fmt-hero-cards{grid-template-columns:repeat(2,1fr);}}.fmt-hcard{background:var(--fmt-card);border:1px solid rgba(49,29,124,.10);border-radius:14px; padding:14px 10px;text-align:center;box-shadow:0 6px 18px rgba(2,20,36,.06); display:flex;flex-direction:column;gap:2px;justify-content:center;}.fmt-hcard-plat{font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;}.fmt-hcard--ig .fmt-hcard-plat{color:var(--fmt-ig);}.fmt-hcard--tt .fmt-hcard-plat{color:var(--fmt-tt);}.fmt-hcard--yt .fmt-hcard-plat{color:var(--fmt-yt);}.fmt-hcard-name{font-size:14px;font-weight:800;color:var(--fmt-ink);line-height:1.25;}.fmt-hcard-price{font-size:12.5px;font-weight:700;color:var(--fmt-muted);margin-top:4px;}.fmt-ticker{max-width:1180px;margin:0 auto 56px;background:#fff;border:1px solid rgba(49,29,124,.10); border-radius:999px;box-shadow:0 6px 18px rgba(2,20,36,.06);overflow:hidden;position:relative;}.fmt-ticker::before,.fmt-ticker::after{content:"";position:absolute;top:0;bottom:0;width:60px;z-index:2;pointer-events:none;}.fmt-ticker::before{left:0;background:linear-gradient(90deg,#fff,transparent);}.fmt-ticker::after{right:0;background:linear-gradient(270deg,#fff,transparent);}.fmt-ticker-track{display:flex;gap:34px;width:max-content;padding:12px 0;animation:fmt-slide 38s linear infinite;}.fmt-ticker:hover .fmt-ticker-track{animation-play-state:paused;}@keyframes fmt-slide{from{transform:translateX(0);}to{transform:translateX(-50%);}}@media (prefers-reduced-motion:reduce){.fmt-ticker-track{animation:none;flex-wrap:wrap;width:auto;justify-content:center;}}.fmt-tick{display:inline-flex;align-items:center;gap:8px;font-size:13.5px;color:var(--fmt-ink);white-space:nowrap;}.fmt-tick b{color:var(--fmt-brand);}.fmt-tick i{font-style:normal;color:var(--fmt-muted);font-size:12.5px;}.fmt-tick-dot{width:7px;height:7px;border-radius:999px;background:var(--fmt-trust);flex:0 0 auto;}.fmt-press{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:28px;align-items:center; justify-items:center;padding:26px 18px;background:var(--fmt-card);border-radius:18px; border:1px solid rgba(49,29,124,.10);box-shadow:0 8px 24px rgba(2,20,36,.06);}.fmt-press img{max-height:42px;max-width:140px;object-fit:contain;filter:grayscale(100%);opacity:.85; transition:filter 200ms ease,opacity 200ms ease,transform 200ms ease;}.fmt-press img:hover{filter:grayscale(0);opacity:1;transform:translateY(-2px);}.fmt-plat-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;}@media (max-width:1040px){.fmt-plat-grid{grid-template-columns:repeat(3,1fr);}}@media (max-width:700px){.fmt-plat-grid{grid-template-columns:1fr;}}.fmt-plat{background:var(--fmt-card);border-radius:16px;padding:22px 18px;text-align:left; border:1px solid rgba(49,29,124,.10);box-shadow:0 8px 24px rgba(2,20,36,.06); display:flex;flex-direction:column;gap:10px; transition:transform 220ms ease,box-shadow 220ms ease,border-color 220ms ease;}.fmt-plat:hover{transform:translateY(-6px);box-shadow:0 14px 36px rgba(49,29,124,.16);border-color:var(--fmt-ring);}.fmt-plat-icon{width:46px;height:46px;border-radius:13px;display:grid;place-items:center;color:#fff; font-size:22px;line-height:1;box-shadow:0 6px 16px rgba(2,20,36,.18);}.fmt-plat-icon i{font-size:22px;line-height:1;display:block;}.fmt-plat--ig .fmt-plat-icon{background:linear-gradient(135deg,#833AB4,#E1306C,#F56040);}.fmt-plat--tt .fmt-plat-icon{background:linear-gradient(135deg,#25F4EE,#010101 55%,#FE2C55);}.fmt-plat--yt .fmt-plat-icon{background:#FF0000;}.fmt-plat--fb .fmt-plat-icon{background:#1877F2;}.fmt-plat--x .fmt-plat-icon{background:#0f1419;}.fmt-plat h3{margin:0;font-size:17px;font-weight:800;color:var(--fmt-ink);}.fmt-plat ul{list-style:none;margin:0;padding:0;display:grid;gap:6px;}.fmt-plat ul a{font-size:13.5px;color:var(--fmt-muted);text-decoration:none;}.fmt-plat ul a:hover{color:var(--fmt-brand);text-decoration:underline;}.fmt-plat-cta{margin-top:auto;font-size:13.5px;font-weight:800;color:var(--fmt-brand);text-decoration:none;padding-top:6px;}.fmt